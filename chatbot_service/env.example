# 360dialog WhatsApp Sandbox API
# Get your key: Send "START" to WhatsApp +55 11 4673 3492
D360_API_KEY=your_360dialog_api_key
D360_BASE_URL=https://waba-sandbox.360dialog.io

# Your phone number (must match the one that got the API key)
MY_PHONE_NUMBER=6289654108308

# Data source: true = mock data (for local testing), false = real API
USE_MOCK_DATA=true

# Mulai Gym API (only needed when USE_MOCK_DATA=false)
GYM_API_BASE_URL=http://localhost:8000
GYM_API_KEY=your_gym_api_key
